PORT=5000
# Prefer the full MongoDB connection string. Otherwise comment it out and set
# DB_USER and DB_PASSWORD; MONGODB_HOST is optional for that connection mode.
DB_NAME=wed-plan
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# DB_USER=replace_me
# DB_PASSWORD=replace_me
# MONGODB_HOST=ac-tfbmyvt-shard-00-00.drmhua0.mongodb.net:27017,ac-tfbmyvt-shard-00-01.drmhua0.mongodb.net:27017,ac-tfbmyvt-shard-00-02.drmhua0.mongodb.net:27017
# Optional: defaults to BETTER_AUTH_URL for checkout redirects and CORS.
CLIENT_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_AMOUNT=2900
STRIPE_PREMIUM_CURRENCY=usd
IMGBB_API_KEY=replace_me
